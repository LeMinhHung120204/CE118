// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "12/01/2024 15:21:24"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    Datapath
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module Datapath_vlg_sample_tst(
	C,
	CLK,
	I,
	sampler_tx
);
input [2:0] C;
input  CLK;
input [7:0] I;
output sampler_tx;

reg sample;
time current_time;
always @(C or CLK or I)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module Datapath_vlg_check_tst (
	Check,
	Q,
	U,
	sampler_rx
);
input  Check;
input [3:0] Q;
input [7:0] U;
input sampler_rx;

reg  Check_expected;
reg [3:0] Q_expected;
reg [7:0] U_expected;

reg  Check_prev;
reg [3:0] Q_prev;
reg [7:0] U_prev;

reg  Check_expected_prev;
reg [3:0] Q_expected_prev;
reg [7:0] U_expected_prev;

reg  last_Check_exp;
reg [3:0] last_Q_exp;
reg [7:0] last_U_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:3] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 3'b1;
end

// update real /o prevs

always @(trigger)
begin
	Check_prev = Check;
	Q_prev = Q;
	U_prev = U;
end

// update expected /o prevs

always @(trigger)
begin
	Check_expected_prev = Check_expected;
	Q_expected_prev = Q_expected;
	U_expected_prev = U_expected;
end



// expected Check
initial
begin
	Check_expected = 1'bX;
end 
// expected Q[ 3 ]
initial
begin
	Q_expected[3] = 1'bX;
end 
// expected Q[ 2 ]
initial
begin
	Q_expected[2] = 1'bX;
end 
// expected Q[ 1 ]
initial
begin
	Q_expected[1] = 1'bX;
end 
// expected Q[ 0 ]
initial
begin
	Q_expected[0] = 1'bX;
end 
// expected U[ 7 ]
initial
begin
	U_expected[7] = 1'bX;
end 
// expected U[ 6 ]
initial
begin
	U_expected[6] = 1'bX;
end 
// expected U[ 5 ]
initial
begin
	U_expected[5] = 1'bX;
end 
// expected U[ 4 ]
initial
begin
	U_expected[4] = 1'bX;
end 
// expected U[ 3 ]
initial
begin
	U_expected[3] = 1'bX;
end 
// expected U[ 2 ]
initial
begin
	U_expected[2] = 1'bX;
end 
// expected U[ 1 ]
initial
begin
	U_expected[1] = 1'bX;
end 
// expected U[ 0 ]
initial
begin
	U_expected[0] = 1'bX;
end 
// generate trigger
always @(Check_expected or Check or Q_expected or Q or U_expected or U)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected Check = %b | expected Q = %b | expected U = %b | ",Check_expected_prev,Q_expected_prev,U_expected_prev);
	$display("| real Check = %b | real Q = %b | real U = %b | ",Check_prev,Q_prev,U_prev);
`endif
	if (
		( Check_expected_prev !== 1'bx ) && ( Check_prev !== Check_expected_prev )
		&& ((Check_expected_prev !== last_Check_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Check :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Check_expected_prev);
		$display ("     Real value = %b", Check_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Check_exp = Check_expected_prev;
	end
	if (
		( Q_expected_prev[0] !== 1'bx ) && ( Q_prev[0] !== Q_expected_prev[0] )
		&& ((Q_expected_prev[0] !== last_Q_exp[0]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q_expected_prev);
		$display ("     Real value = %b", Q_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Q_exp[0] = Q_expected_prev[0];
	end
	if (
		( Q_expected_prev[1] !== 1'bx ) && ( Q_prev[1] !== Q_expected_prev[1] )
		&& ((Q_expected_prev[1] !== last_Q_exp[1]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q_expected_prev);
		$display ("     Real value = %b", Q_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Q_exp[1] = Q_expected_prev[1];
	end
	if (
		( Q_expected_prev[2] !== 1'bx ) && ( Q_prev[2] !== Q_expected_prev[2] )
		&& ((Q_expected_prev[2] !== last_Q_exp[2]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q_expected_prev);
		$display ("     Real value = %b", Q_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Q_exp[2] = Q_expected_prev[2];
	end
	if (
		( Q_expected_prev[3] !== 1'bx ) && ( Q_prev[3] !== Q_expected_prev[3] )
		&& ((Q_expected_prev[3] !== last_Q_exp[3]) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q_expected_prev);
		$display ("     Real value = %b", Q_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Q_exp[3] = Q_expected_prev[3];
	end
	if (
		( U_expected_prev[0] !== 1'bx ) && ( U_prev[0] !== U_expected_prev[0] )
		&& ((U_expected_prev[0] !== last_U_exp[0]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port U[0] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", U_expected_prev);
		$display ("     Real value = %b", U_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_U_exp[0] = U_expected_prev[0];
	end
	if (
		( U_expected_prev[1] !== 1'bx ) && ( U_prev[1] !== U_expected_prev[1] )
		&& ((U_expected_prev[1] !== last_U_exp[1]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port U[1] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", U_expected_prev);
		$display ("     Real value = %b", U_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_U_exp[1] = U_expected_prev[1];
	end
	if (
		( U_expected_prev[2] !== 1'bx ) && ( U_prev[2] !== U_expected_prev[2] )
		&& ((U_expected_prev[2] !== last_U_exp[2]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port U[2] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", U_expected_prev);
		$display ("     Real value = %b", U_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_U_exp[2] = U_expected_prev[2];
	end
	if (
		( U_expected_prev[3] !== 1'bx ) && ( U_prev[3] !== U_expected_prev[3] )
		&& ((U_expected_prev[3] !== last_U_exp[3]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port U[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", U_expected_prev);
		$display ("     Real value = %b", U_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_U_exp[3] = U_expected_prev[3];
	end
	if (
		( U_expected_prev[4] !== 1'bx ) && ( U_prev[4] !== U_expected_prev[4] )
		&& ((U_expected_prev[4] !== last_U_exp[4]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port U[4] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", U_expected_prev);
		$display ("     Real value = %b", U_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_U_exp[4] = U_expected_prev[4];
	end
	if (
		( U_expected_prev[5] !== 1'bx ) && ( U_prev[5] !== U_expected_prev[5] )
		&& ((U_expected_prev[5] !== last_U_exp[5]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port U[5] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", U_expected_prev);
		$display ("     Real value = %b", U_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_U_exp[5] = U_expected_prev[5];
	end
	if (
		( U_expected_prev[6] !== 1'bx ) && ( U_prev[6] !== U_expected_prev[6] )
		&& ((U_expected_prev[6] !== last_U_exp[6]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port U[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", U_expected_prev);
		$display ("     Real value = %b", U_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_U_exp[6] = U_expected_prev[6];
	end
	if (
		( U_expected_prev[7] !== 1'bx ) && ( U_prev[7] !== U_expected_prev[7] )
		&& ((U_expected_prev[7] !== last_U_exp[7]) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port U[7] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", U_expected_prev);
		$display ("     Real value = %b", U_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_U_exp[7] = U_expected_prev[7];
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module Datapath_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [2:0] C;
reg CLK;
reg [7:0] I;
// wires                                               
wire Check;
wire [3:0] Q;
wire [7:0] U;

wire sampler;                             

// assign statements (if any)                          
Datapath i1 (
// port map - connection between master ports and signals/registers   
	.C(C),
	.Check(Check),
	.CLK(CLK),
	.I(I),
	.Q(Q),
	.U(U)
);

// CLK
always
begin
	CLK = 1'b0;
	CLK = #5000 1'b1;
	#5000;
end 
// C[ 2 ]
initial
begin
	C[2] = 1'b1;
	C[2] = #10000 1'b0;
end 
// C[ 1 ]
initial
begin
	C[1] = 1'b0;
	C[1] = #10000 1'b1;
	C[1] = #70000 1'b0;
end 
// C[ 0 ]
initial
begin
	C[0] = 1'b1;
	C[0] = #10000 1'b0;
end 
// I[ 7 ]
initial
begin
	I[7] = 1'b0;
end 
// I[ 6 ]
initial
begin
	I[6] = 1'b0;
end 
// I[ 5 ]
initial
begin
	I[5] = 1'b1;
	I[5] = #10000 1'b0;
end 
// I[ 4 ]
initial
begin
	I[4] = 1'b1;
	I[4] = #10000 1'b0;
end 
// I[ 3 ]
initial
begin
	I[3] = 1'b1;
	I[3] = #10000 1'b0;
end 
// I[ 2 ]
initial
begin
	I[2] = 1'b0;
end 
// I[ 1 ]
initial
begin
	I[1] = 1'b0;
end 
// I[ 0 ]
initial
begin
	I[0] = 1'b0;
end 

Datapath_vlg_sample_tst tb_sample (
	.C(C),
	.CLK(CLK),
	.I(I),
	.sampler_tx(sampler)
);

Datapath_vlg_check_tst tb_out(
	.Check(Check),
	.Q(Q),
	.U(U),
	.sampler_rx(sampler)
);
endmodule

