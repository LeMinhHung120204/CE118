`timescale 1 ps/ 1 ps
module Datapath_vlg_sample_tst(
	CLK,
	COP,
	In1,
	In2,
	RAA1,
	RAA2,
	RAA3,
	REA1,
	REA2,
	REA3,
	S1,
	S2,
	WA1,
	WA2,
	WA3,
	WE1,
	WE2,
	WE3,
	sampler_tx
);
input  CLK;
input  COP;
input [7:0] In1;
input [7:0] In2;
input [1:0] RAA1;
input [2:0] RAA2;
input [1:0] RAA3;
input  REA1;
input  REA2;
input  REA3;
input [1:0] S1;
input [2:0] S2;
input [1:0] WA1;
input [2:0] WA2;
input [1:0] WA3;
input  WE1;
input  WE2;
input  WE3;
output sampler_tx;

reg sample;
time current_time;
always @(CLK or COP or In1 or In2 or RAA1 or RAA2 or RAA3 or REA1 or REA2 or REA3 or S1 or S2 or WA1 or WA2 or WA3 or WE1 or WE2 or WE3)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

