// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "11/26/2024 15:12:13"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    NextState
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module NextState_vlg_sample_tst(
	Q,
	sampler_tx
);
input [3:0] Q;
output sampler_tx;

reg sample;
time current_time;
always @(Q)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module NextState_vlg_check_tst (
	D,
	sampler_rx
);
input [3:0] D;
input sampler_rx;

reg [3:0] D_expected;

reg [3:0] D_prev;



reg trigger;

integer i;
integer nummismatches;

reg [1:1] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 1'b1;
end

// update real /o prevs

always @(trigger)
begin
	D_prev = D;
end

// update expected /o prevs

always @(trigger)
begin
end


// expected Q[ 3 ]
initial
begin
	Q_expected[3] = 1'bX;
end 
// expected Q[ 2 ]
initial
begin
	Q_expected[2] = 1'bX;
end 
// expected Q[ 1 ]
initial
begin
	Q_expected[1] = 1'bX;
end 
// expected Q[ 0 ]
initial
begin
	Q_expected[0] = 1'bX;
end 
// generate trigger
always @(D_expected or D)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected D = %b | ",D_expected_prev);
	$display("| real D = %b | ",D_prev);
`endif

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$stop;
end 
endmodule

module NextState_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [3:0] Q;
// wires                                               
wire [3:0] D;

wire sampler;                             

// assign statements (if any)                          
NextState i1 (
// port map - connection between master ports and signals/registers   
	.D(D),
	.Q(Q)
);

NextState_vlg_sample_tst tb_sample (
	.Q(Q),
	.sampler_tx(sampler)
);

NextState_vlg_check_tst tb_out(
	.D(D),
	.sampler_rx(sampler)
);
endmodule

