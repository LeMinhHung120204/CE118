// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "10/08/2024 00:19:18"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    LIFO
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module LIFO_vlg_sample_tst(
	CLK,
	Enable,
	IO0,
	IO1,
	IO2,
	IO3,
	IO4,
	IO5,
	IO6,
	IO7,
	Push/Pop,
	Reset,
	sampler_tx
);
input  CLK;
input  Enable;
input  IO0;
input  IO1;
input  IO2;
input  IO3;
input  IO4;
input  IO5;
input  IO6;
input  IO7;
input  Push/Pop;
input  Reset;
output sampler_tx;

reg sample;
time current_time;
always @(CLK or Enable or IO0 or IO1 or IO2 or IO3 or IO4 or IO5 or IO6 or IO7 or Push/Pop or Reset)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module LIFO_vlg_check_tst (
	Empty,
	Full,
	IO0,
	IO1,
	IO2,
	IO3,
	IO4,
	IO5,
	IO6,
	IO7,
	sampler_rx
);
input  Empty;
input  Full;
input  IO0;
input  IO1;
input  IO2;
input  IO3;
input  IO4;
input  IO5;
input  IO6;
input  IO7;
input sampler_rx;

reg  Empty_expected;
reg  Full_expected;
reg  IO0_expected;
reg  IO1_expected;
reg  IO2_expected;
reg  IO3_expected;
reg  IO4_expected;
reg  IO5_expected;
reg  IO6_expected;
reg  IO7_expected;

reg  Empty_prev;
reg  Full_prev;
reg  IO0_prev;
reg  IO1_prev;
reg  IO2_prev;
reg  IO3_prev;
reg  IO4_prev;
reg  IO5_prev;
reg  IO6_prev;
reg  IO7_prev;

reg  Empty_expected_prev;
reg  Full_expected_prev;
reg  IO0_expected_prev;
reg  IO1_expected_prev;
reg  IO2_expected_prev;
reg  IO3_expected_prev;
reg  IO4_expected_prev;
reg  IO5_expected_prev;
reg  IO6_expected_prev;
reg  IO7_expected_prev;

reg  last_Empty_exp;
reg  last_Full_exp;
reg  last_IO0_exp;
reg  last_IO1_exp;
reg  last_IO2_exp;
reg  last_IO3_exp;
reg  last_IO4_exp;
reg  last_IO5_exp;
reg  last_IO6_exp;
reg  last_IO7_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:10] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 10'b1;
end

// update real /o prevs

always @(trigger)
begin
	Empty_prev = Empty;
	Full_prev = Full;
	IO0_prev = IO0;
	IO1_prev = IO1;
	IO2_prev = IO2;
	IO3_prev = IO3;
	IO4_prev = IO4;
	IO5_prev = IO5;
	IO6_prev = IO6;
	IO7_prev = IO7;
end

// update expected /o prevs

always @(trigger)
begin
	Empty_expected_prev = Empty_expected;
	Full_expected_prev = Full_expected;
	IO0_expected_prev = IO0_expected;
	IO1_expected_prev = IO1_expected;
	IO2_expected_prev = IO2_expected;
	IO3_expected_prev = IO3_expected;
	IO4_expected_prev = IO4_expected;
	IO5_expected_prev = IO5_expected;
	IO6_expected_prev = IO6_expected;
	IO7_expected_prev = IO7_expected;
end



// expected Empty
initial
begin
	Empty_expected = 1'bX;
end 

// expected Full
initial
begin
	Full_expected = 1'bX;
end 
// generate trigger
always @(Empty_expected or Empty or Full_expected or Full or IO0_expected or IO0 or IO1_expected or IO1 or IO2_expected or IO2 or IO3_expected or IO3 or IO4_expected or IO4 or IO5_expected or IO5 or IO6_expected or IO6 or IO7_expected or IO7)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected Empty = %b | expected Full = %b | expected IO0 = %b | expected IO1 = %b | expected IO2 = %b | expected IO3 = %b | expected IO4 = %b | expected IO5 = %b | expected IO6 = %b | expected IO7 = %b | ",Empty_expected_prev,Full_expected_prev,IO0_expected_prev,IO1_expected_prev,IO2_expected_prev,IO3_expected_prev,IO4_expected_prev,IO5_expected_prev,IO6_expected_prev,IO7_expected_prev);
	$display("| real Empty = %b | real Full = %b | real IO0 = %b | real IO1 = %b | real IO2 = %b | real IO3 = %b | real IO4 = %b | real IO5 = %b | real IO6 = %b | real IO7 = %b | ",Empty_prev,Full_prev,IO0_prev,IO1_prev,IO2_prev,IO3_prev,IO4_prev,IO5_prev,IO6_prev,IO7_prev);
`endif
	if (
		( Empty_expected_prev !== 1'bx ) && ( Empty_prev !== Empty_expected_prev )
		&& ((Empty_expected_prev !== last_Empty_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Empty :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Empty_expected_prev);
		$display ("     Real value = %b", Empty_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_Empty_exp = Empty_expected_prev;
	end
	if (
		( Full_expected_prev !== 1'bx ) && ( Full_prev !== Full_expected_prev )
		&& ((Full_expected_prev !== last_Full_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Full :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Full_expected_prev);
		$display ("     Real value = %b", Full_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_Full_exp = Full_expected_prev;
	end
	if (
		( IO0_expected_prev !== 1'bx ) && ( IO0_prev !== IO0_expected_prev )
		&& ((IO0_expected_prev !== last_IO0_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port IO0 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", IO0_expected_prev);
		$display ("     Real value = %b", IO0_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_IO0_exp = IO0_expected_prev;
	end
	if (
		( IO1_expected_prev !== 1'bx ) && ( IO1_prev !== IO1_expected_prev )
		&& ((IO1_expected_prev !== last_IO1_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port IO1 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", IO1_expected_prev);
		$display ("     Real value = %b", IO1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_IO1_exp = IO1_expected_prev;
	end
	if (
		( IO2_expected_prev !== 1'bx ) && ( IO2_prev !== IO2_expected_prev )
		&& ((IO2_expected_prev !== last_IO2_exp) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port IO2 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", IO2_expected_prev);
		$display ("     Real value = %b", IO2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_IO2_exp = IO2_expected_prev;
	end
	if (
		( IO3_expected_prev !== 1'bx ) && ( IO3_prev !== IO3_expected_prev )
		&& ((IO3_expected_prev !== last_IO3_exp) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port IO3 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", IO3_expected_prev);
		$display ("     Real value = %b", IO3_prev);
		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_IO3_exp = IO3_expected_prev;
	end
	if (
		( IO4_expected_prev !== 1'bx ) && ( IO4_prev !== IO4_expected_prev )
		&& ((IO4_expected_prev !== last_IO4_exp) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port IO4 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", IO4_expected_prev);
		$display ("     Real value = %b", IO4_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_IO4_exp = IO4_expected_prev;
	end
	if (
		( IO5_expected_prev !== 1'bx ) && ( IO5_prev !== IO5_expected_prev )
		&& ((IO5_expected_prev !== last_IO5_exp) ||
			on_first_change[8])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port IO5 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", IO5_expected_prev);
		$display ("     Real value = %b", IO5_prev);
		nummismatches = nummismatches + 1;
		on_first_change[8] = 1'b0;
		last_IO5_exp = IO5_expected_prev;
	end
	if (
		( IO6_expected_prev !== 1'bx ) && ( IO6_prev !== IO6_expected_prev )
		&& ((IO6_expected_prev !== last_IO6_exp) ||
			on_first_change[9])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port IO6 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", IO6_expected_prev);
		$display ("     Real value = %b", IO6_prev);
		nummismatches = nummismatches + 1;
		on_first_change[9] = 1'b0;
		last_IO6_exp = IO6_expected_prev;
	end
	if (
		( IO7_expected_prev !== 1'bx ) && ( IO7_prev !== IO7_expected_prev )
		&& ((IO7_expected_prev !== last_IO7_exp) ||
			on_first_change[10])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port IO7 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", IO7_expected_prev);
		$display ("     Real value = %b", IO7_prev);
		nummismatches = nummismatches + 1;
		on_first_change[10] = 1'b0;
		last_IO7_exp = IO7_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module LIFO_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK;
reg Enable;
reg treg_IO0;
reg treg_IO1;
reg treg_IO2;
reg treg_IO3;
reg treg_IO4;
reg treg_IO5;
reg treg_IO6;
reg treg_IO7;
reg Push/Pop;
reg Reset;
// wires                                               
wire Empty;
wire Full;
wire IO0;
wire IO1;
wire IO2;
wire IO3;
wire IO4;
wire IO5;
wire IO6;
wire IO7;

wire sampler;                             

// assign statements (if any)                          
assign IO0 = treg_IO0;
assign IO1 = treg_IO1;
assign IO2 = treg_IO2;
assign IO3 = treg_IO3;
assign IO4 = treg_IO4;
assign IO5 = treg_IO5;
assign IO6 = treg_IO6;
assign IO7 = treg_IO7;
LIFO i1 (
// port map - connection between master ports and signals/registers   
	.CLK(CLK),
	.Empty(Empty),
	.Enable(Enable),
	.Full(Full),
	.IO0(IO0),
	.IO1(IO1),
	.IO2(IO2),
	.IO3(IO3),
	.IO4(IO4),
	.IO5(IO5),
	.IO6(IO6),
	.IO7(IO7),
	.\Push/Pop (Push/Pop),
	.Reset(Reset)
);

// CLK
always
begin
	CLK = 1'b0;
	CLK = #5000 1'b1;
	#5000;
end 

// Enable
initial
begin
	Enable = 1'bZ;
end 

// IO7
initial
begin
	treg_IO7 = 1'b1;
	treg_IO7 = #20000 1'bZ;
end 

// IO6
initial
begin
	treg_IO6 = 1'b1;
	treg_IO6 = #20000 1'bZ;
end 

// IO5
initial
begin
	treg_IO5 = 1'b1;
	treg_IO5 = #20000 1'bZ;
end 

// IO4
initial
begin
	treg_IO4 = 1'b1;
	treg_IO4 = #20000 1'bZ;
end 

// IO3
initial
begin
	treg_IO3 = 1'b1;
	treg_IO3 = #20000 1'bZ;
end 

// IO2
initial
begin
	treg_IO2 = 1'b1;
	treg_IO2 = #20000 1'bZ;
end 

// IO1
initial
begin
	treg_IO1 = 1'b1;
	treg_IO1 = #20000 1'bZ;
end 

// IO0
initial
begin
	treg_IO0 = 1'b1;
	treg_IO0 = #20000 1'bZ;
end 

// Push/Pop
initial
begin
	Push/Pop = 1'b0;
	Push/Pop = #20000 1'b1;
	Push/Pop = #10000 1'b0;
end 

// Reset
initial
begin
	Reset = 1'b1;
end 

LIFO_vlg_sample_tst tb_sample (
	.CLK(CLK),
	.Enable(Enable),
	.IO0(IO0),
	.IO1(IO1),
	.IO2(IO2),
	.IO3(IO3),
	.IO4(IO4),
	.IO5(IO5),
	.IO6(IO6),
	.IO7(IO7),
	.Push/Pop(Push/Pop),
	.Reset(Reset),
	.sampler_tx(sampler)
);

LIFO_vlg_check_tst tb_out(
	.Empty(Empty),
	.Full(Full),
	.IO0(IO0),
	.IO1(IO1),
	.IO2(IO2),
	.IO3(IO3),
	.IO4(IO4),
	.IO5(IO5),
	.IO6(IO6),
	.IO7(IO7),
	.sampler_rx(sampler)
);
endmodule

